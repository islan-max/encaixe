# Exemplo de configuração. Copie para .env (que o Git ignora) ou defina no painel da hospedagem.
# Nunca ponha valores reais neste arquivo.

# Banco Postgres. No Neon: Connection string, com o host que termina em "-pooler".
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# "producao" liga cookie seguro (__Host-, Secure), HSTS e exige SECRET_KEY de 32+ caracteres.
ENCAIXE_ENV=producao

# 32+ caracteres aleatórios. Assina o login com Google e deriva os links das reservas.
# ATENÇÃO: trocar este valor invalida os links de reserva que você já mandou aos clientes.
SECRET_KEY=

# Endereço público do site, sem barra no fim. Usado no retorno do login com Google e nos links.
BASE_URL=https://seu-app.onrender.com

# IP do visitante para o limite de tentativas (nunca é gravado). Cabeçalho que o proxy de
# confiança sobrescreve: no Render (atrás do Cloudflare), cf-connecting-ip. Vazio = endereço da conexão.
CLIENT_IP_HEADER=cf-connecting-ip
# Alternativa: quantos proxies de confiança acrescentam ao X-Forwarded-For (0 = ninguém).
PROXY_HOPS=0

# Segredo da limpeza diária (POST /interno/limpeza). Também vai nos segredos do GitHub.
CRON_SECRET=

# Opcionais
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONTATO_EMAIL=
